<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="30dp"
    android:background="@color/color2"
    tools:context=".phonecare.Administrador.IngresarMantActivity">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Sistema Mantenimiento"
        android:textSize="30sp"
        android:textColor="@color/color8"
        android:textStyle="bold"
        android:textAlignment="center"
        >
    </TextView>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/etReq"
        android:hint="Requerimiento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="70dp"
        android:inputType="textPersonName"
        android:textColorHint="@color/color11"
        android:textColor="@color/color11"
        android:backgroundTint="@color/color1"
        >
    </EditText>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/etAccesorios"
        android:hint="Accesorios"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etReq"
        android:layout_marginTop="10dp"
        android:inputType="textPersonName"
        android:textColorHint="@color/color11"
        android:textColor="@color/color11"
        android:backgroundTint="@color/color1"
        >
    </EditText>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/etEstado"
        android:hint="Estado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etAccesorios"
        android:layout_marginTop="10dp"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:textColorHint="@color/color11"
        android:textColor="@color/color11"
        android:backgroundTint="@color/color1"
        >
    </EditText>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/etPago"
        android:hint="Pago"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etEstado"
        android:layout_marginTop="10dp"
        android:inputType="textPersonName"
        android:textColorHint="@color/color11"
        android:textColor="@color/color11"
        android:backgroundTint="@color/color1"
        >
    </EditText>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/btnMant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etPago"
        android:text="Registrar"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:textColor="@color/color8"
        android:backgroundTint="@color/color5"
        android:textSize="20sp"
        >
    </Button>

</androidx.constraintlayout.widget.ConstraintLayout>