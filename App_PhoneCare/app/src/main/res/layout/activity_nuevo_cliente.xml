<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="30dp"
    android:background="@color/color2"
    tools:context=".phonecare.Administrador.NuevoClienteActivity">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Sistema Mantenimiento"
        android:textSize="30sp"
        android:textColor="@color/color8"
        android:textStyle="bold"
        android:textAlignment="center"
        >
    </TextView>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/etUsuario"
        android:hint="Usuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="70dp"
        android:inputType="textPersonName"
        android:textColorHint="@color/color11"
        android:textColor="@color/color11"
        >
    </EditText>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/etPassword"
        android:hint="Password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etUsuario"
        android:layout_marginTop="10dp"
        android:inputType="textPersonName"
        android:textColorHint="@color/color11"
        android:textColor="@color/color11"
        >
    </EditText>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/etCedula"
        android:hint="Cedula"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etPassword"
        android:layout_marginTop="10dp"
        android:inputType="textPersonName"
        android:textColorHint="@color/color11"
        android:textColor="@color/color11"

        >
    </EditText>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/etNombre"
        android:hint="Nombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etCedula"
        android:layout_marginTop="10dp"
        android:inputType="textPersonName"
        android:textColorHint="@color/color11"
        android:textColor="@color/color11"

        >
    </EditText>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/etCorreo"
        android:hint="Correo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etNombre"
        android:layout_marginTop="10dp"
        android:inputType="textPersonName"
        android:textColorHint="@color/color11"
        android:textColor="@color/color11"

        >
    </EditText>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/etWhatsapp"
        android:hint="Whatsapp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etCorreo"
        android:layout_marginTop="10dp"
        android:inputType="textPersonName"
        android:textColorHint="@color/color11"
        android:textColor="@color/color11"

        >
    </EditText>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/etMarca"
        android:hint="Marca telefono"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etWhatsapp"
        android:layout_marginTop="10dp"
        android:inputType="textPersonName"
        android:textColorHint="@color/color11"
        android:textColor="@color/color11"

        >
    </EditText>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/btnRegistrar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etMarca"
        android:text="Registrar"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:textColor="@color/color9"
        android:backgroundTint="@color/color5"
        android:textSize="20sp"
        >
    </Button>

</androidx.constraintlayout.widget.ConstraintLayout>